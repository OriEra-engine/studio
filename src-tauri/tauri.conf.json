{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OriEra Studio",
  "version": "0.5.0",
  "identifier": "cn.oriera.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OriEra Studio — 世界引擎工作台",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "../engine-snapshot": "engine-snapshot/"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
